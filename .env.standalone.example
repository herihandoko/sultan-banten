# Ganti sesuai domain / IP server
CORS_ORIGINS=https://siagapim.bantenprov.go.id,http://siagapim.bantenprov.go.id,http://localhost:8080

MATA_BATHIN_ENABLED=false
MATA_BATHIN_BASE_URL=
MATA_BATHIN_API_KEY=
