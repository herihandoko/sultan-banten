# Email SMTP (Media Hub)
MAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_HOST=mx-relay-1.eradata.id
MAIL_PORT=1587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@bantenprov.go.id
MAIL_FROM_NAME="SIAGAPIM Banten"

# WhatsApp — Fonnte (quote token jika ada karakter #)
FONNTE_TOKEN=
FONNTE_COUNTRY_CODE=62
FONNTE_DELAY=2
CRISIS_WA_NUMBER=

# SIPANTAU crisis → Crisis Room lookback (hours) — set on panten service
# CRISIS_LOOKBACK_HOURS=48

# SIPANTAU native social APIs (required for real X/IG/FB/TikTok mentions)
# OpenAI web_search alone almost never returns posts from these platforms.
# X_BEARER_TOKEN=          # X/Twitter API v2 Bearer — Recent Search (aktif sekarang)
# TWITTER_BEARER_TOKEN=    # alias of X_BEARER_TOKEN
# META_ACCESS_TOKEN=       # Facebook/Instagram Graph (App Review; belum diaktifkan)
# TIKTOK_ACCESS_TOKEN=     # TikTok Research/Commercial API (perlu approval)

# SIPANTAU OpenAI crawl
# OPENAI_API_KEY=
# OPENAI_INGEST_MODEL=gpt-4o-mini
# INGEST_ADAPTER=openai
# INGEST_LIMIT=10
# INGEST_INTERVAL_MS=0
# INGEST_DAILY_AT=07:00
# INGEST_TZ=Asia/Jakarta
# CRISIS_PUSH_LIMIT=10

RUN_SEED=true
API_PORT=5001
WEB_PORT=8080
