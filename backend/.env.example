SECRET_KEY=dev-secret-change-me-sultan-banten-local
JWT_SECRET_KEY=dev-jwt-secret-change-me-sultan-banten-32b

# SQLite (default lokal):
# DATABASE_URL=sqlite:///instance/sultan_banten.db

# PostgreSQL (Docker / produksi) — contoh via host port 5433:
# DATABASE_URL=postgresql+psycopg2://postgres:secret@127.0.0.1:5433/sultan_banten

DATABASE_URL=sqlite:///instance/sultan_banten.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Mata Bathin integration (disable until endpoint ready)
MATA_BATHIN_ENABLED=false
