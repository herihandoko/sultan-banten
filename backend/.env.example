# SQLite (default lokal):
# DATABASE_URL=sqlite:///instance/sultan_banten.db

# PostgreSQL (Docker / produksi) — contoh via host port 5433:
# DATABASE_URL=postgresql+psycopg2://postgres:secret@127.0.0.1:5433/sultan_banten

DATABASE_URL=sqlite:///instance/sultan_banten.db
