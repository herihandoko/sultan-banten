# Copy ke deploy/.env.deploy lalu isi password.
# File .env.deploy TIDAK di-commit ke git.

DEPLOY_HOST=10.249.101.43
DEPLOY_USER=python
DEPLOY_PORT=22
DEPLOY_PASSWORD=ganti-password-ssh
# Kosongkan jika password sudo sama dengan SSH
DEPLOY_SUDO_PASSWORD=
DEPLOY_USE_SUDO=1

DEPLOY_REMOTE_DIR=/home/python/apps/sultan-banten
DEPLOY_PANTEN_REMOTE_DIR=/home/python/apps/Panten
