DEPLOY_ENV_FILE=.env.standalone

# Setelah rebuild, script cek endpoint ini
DEPLOY_HEALTH_URL=https://siagapim.bantenprov.go.id/api/health
DEPLOY_SIPANTAU_HEALTH_URL=https://siagapim.bantenprov.go.id/sipantau/
