SECRET_KEY=docker-secret-change-me-sultan-banten
JWT_SECRET_KEY=docker-jwt-secret-change-me-sultan-banten-32b

# Postgres existing: cms-vplus-postgres-1 (network cms-vplus_default)
# Host mapping untuk akses dari Mac: localhost:5433
DATABASE_URL=postgresql+psycopg2://postgres:secret@cms-vplus-postgres-1:5432/sultan_banten

# Frontend di Docker di-serve nginx :8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

MATA_BATHIN_ENABLED=false
MATA_BATHIN_BASE_URL=
MATA_BATHIN_API_KEY=
MATA_BATHIN_TIMEOUT=10
MATA_BATHIN_MAX_RETRIES=3

RUN_SEED=true
